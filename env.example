# AI Video Generator - Environment Variables
# Copy this file to .env and fill in your API keys

# Groq API (FREE)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# PiAPI (Kling AI Video Generation)
# Get from: https://piapi.ai/dashboard
PIAPI_API_KEY=your_piapi_api_key_here

# ElevenLabs (Text-to-Speech)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Creatomate (Video Merging)
# Get from: https://creatomate.com/dashboard/api
CREATOMATE_API_KEY=your_creatomate_api_key_here

# Late (TikTok Publishing)
# Get from: https://getlate.dev/dashboard
LATE_API_KEY=sk_your_late_api_key_here
TIKTOK_CONNECTION_ID=your_tiktok_connection_id_here

# YouTube OAuth2 (set up in Google Cloud Console)
# Instructions: https://developers.google.com/youtube/v3/getting-started
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret_here
